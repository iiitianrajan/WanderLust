<% layout("/layouts/boilerplates") %>
  <br>

  <div class="container-xl">
    <div class="row justify-content-center mt-4">
      <div class="col-lg-7 col-md-9 col-sm-11">

        <h2 class="mb-4 text-center">Create New Listing</h2>

        <form method="POST" action="/listing" novalidate class="needs-validation" enctype="multipart/form-data">

          <div class="mb-3">
            <label for="title" class="form-label">Title:</label>
            <!-- required is used when input field of form is required -->
            <input type="text" placeholder="Enter your title" name="listing[title]" id="title" class="form-control"
              required />
            <div class="invalid-feedback">please enter valid title</div>
          </div>

          <div class="mb-3">
            <label for="description" class="form-label">Description:</label>
            <textarea name="listing[description]" placeholder="Enter your description" class="form-control"
              id="description" rows="5" required></textarea>
            <div class="invalid-feedback">please enter short description</div>
          </div>

          <div class="mb-3">
            <label for="url" class="form-label">Upload Listing Image:</label>
            <input type="file" name="listing[image]" class="form-control" id="url" required />
          </div>

          <div class="row">
            <div class="mb-3 col-md-4">
              <label for="price" class="form-label">Price:</label>
              <input type="text" placeholder="Enter price" name="listing[price]" class="form-control" id="price"
                required />
              <div class="invalid-feedback">please enter price</div>
            </div>

            <div class="mb-3 col-md-8">
              <label for="country" class="form-label">Country:</label>
              <input type="text" placeholder="India" name="listing[country]" class="form-control" id="country"
                required />
              <div class="invalid-feedback">please enter country name</div>
            </div>
          </div>

          <div class="mb-3">
            <label class="form-label">Category</label>
            <select name="listing[category]" class="form-control" required>
              <option value="Home">Home</option>
              <option value="Mountain">Mountain</option>
              <option value="Castles">Castles</option>
              <option value="Amazing Pools">Amazing Pools</option>
              <option value="Camping">Camping</option>
              <option value="Farms">Farms</option>
              <option value="Arctic">Arctic</option>
              <option value="Domes">Domes</option>
              <option value="Boats">Boats</option>
              <option value="Iconic City">Iconic City</option>
            </select>
          </div>

          <div class="mb-4">
            <label class="form-label fw-bold mb-3">Select Amenities</label>

            <div class="row g-3">

              <!-- Wifi -->
              <div class="col-md-3">
                <label class="amenity-box">
                  <input type="checkbox" name="listing[amenities][]" value="Wifi">
                  <i class="fa-solid fa-wifi"></i>
                  <span>Wifi</span>
                </label>
              </div>

              <!-- Kitchen -->
              <div class="col-md-3">
                <label class="amenity-box">
                  <input type="checkbox" name="listing[amenities][]" value="Kitchen">
                  <i class="fa-solid fa-utensils"></i>
                  <span>Kitchen</span>
                </label>
              </div>

              <!-- Parking -->
              <div class="col-md-3">
                <label class="amenity-box">
                  <input type="checkbox" name="listing[amenities][]" value="Parking">
                  <i class="fa-solid fa-car"></i>
                  <span>Parking</span>
                </label>
              </div>

              <!-- TV -->
              <div class="col-md-3">
                <label class="amenity-box">
                  <input type="checkbox" name="listing[amenities][]" value="TV">
                  <i class="fa-solid fa-tv"></i>
                  <span>TV</span>
                </label>
              </div>

              <!-- AC -->
              <div class="col-md-3">
                <label class="amenity-box">
                  <input type="checkbox" name="listing[amenities][]" value="AC">
                  <i class="fa-solid fa-snowflake"></i>
                  <span>AC</span>
                </label>
              </div>

              <!-- Pets -->
              <div class="col-md-3">
                <label class="amenity-box">
                  <input type="checkbox" name="listing[amenities][]" value="Pets">
                  <i class="fa-solid fa-paw"></i>
                  <span>Pets</span>
                </label>
              </div>

              <!-- Workspace -->
              <div class="col-md-3">
                <label class="amenity-box">
                  <input type="checkbox" name="listing[amenities][]" value="Workspace">
                  <i class="fa-solid fa-briefcase"></i>
                  <span>Workspace</span>
                </label>
              </div>

              <!-- Security -->
              <div class="col-md-3">
                <label class="amenity-box">
                  <input type="checkbox" name="listing[amenities][]" value="Security">
                  <i class="fa-solid fa-video"></i>
                  <span>Security</span>
                </label>
              </div>

            </div>
          </div>



          <div class="mb-3">
            <label for="location" class="form-label">Location</label>
            <input type="text" placeholder="Enter location" name="listing[location]" class="form-control" id="location"
              required />
            <div class="invalid-feedback">please enter location</div>
          </div>




          <div class="d-grid mt-4">
            <button class="btn btn-dark add-btn">
              Add
            </button>
          </div>

          <br><br>
        </form>

      </div>
    </div>
  </div>