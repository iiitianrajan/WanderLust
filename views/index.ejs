<% layout("/layouts/boilerplates") %>

  

  <div class="box-width mt-3">
    <div id="filters">

      <div class="filter">
        <a href="/listing/trending" style="text-decoration: none; color: inherit;"><i class="fa-solid fa-fire"></i>
        <p>Trending</p>
        </a>
      </div>

      <div class="filter">
        <a href="/listing" style="text-decoration: none; color: inherit;">
        <i class="fa-solid fa-bed"></i>
        <p>Home</p>
        </a>
      </div>

      <div class="filter">
        <a href="/listing/category/Iconic City" style="text-decoration: none; color: inherit;">
        <i class="fa-solid fa-mountain-city"></i>
        <p>Iconic City</p>
        </a>
        
      </div>

      <div class="filter">
        <a href="/listing/category/Mountain" style="text-decoration: none; color: inherit;">
        <i class="fa-solid fa-mountain"></i>
        <p>Mountain</p>
        </a>
      </div>

      <div class="filter">
        <a href="/listing/category/Castles" style="text-decoration: none; color: inherit;">
        <i class="fa-brands fa-fort-awesome"></i>
        <p>Castles</p>
        </a>
        
      </div>

      <div class="filter">
        <a href="/listing/category/Amazing Pools" style="text-decoration: none; color: inherit;">
        <i class="fa-solid fa-person-swimming"></i>
        <p>Amazing Pools</p>
        </a>
      </div>

      <div class="filter">
        <a href="/listing/category/Camping" style="text-decoration: none; color: inherit;">
        <i class="fa-solid fa-campground"></i>
        <p>Camping</p>
        </a>
      </div>

      <div class="filter">
        <a href="/listing/category/Farms" style="text-decoration: none; color: inherit;">
        <i class="fa-solid fa-cow"></i>
        <p>Farms</p>
        </a>
      </div>

      <div class="filter">
        <a href="/listing/category/Arctic" style="text-decoration: none; color: inherit;">
        <i class="fa-regular fa-snowflake"></i>
        <p>Arctic</p>
        </a>
      </div>

      <div class="filter">
        <a href="/listing/category/Domes" style="text-decoration: none; color: inherit;">
        <i class="fa-solid fa-igloo"></i>
        <p>Domes</p>
        </a>
      </div>

      <div class="filter">
        <a href="/listing/category/Boats" style="text-decoration: none; color: inherit;">
        <i class="fa-solid fa-ship"></i>
        <p>Boats</p>
        </a>
      </div>

      <div class="tax-toggle">
        <div class="form-check-reverse form-switch">
          <input class="form-check-input" type="checkbox" id="switchCheckDefault" />
          <label class="form-check-label">
            Display total after taxes
          </label>
        </div>
      </div>

    </div>

    <div class="row row-cols-lg-4 row-cols-md-3 row-cols-2  g-4 mt-3">
      <% for (let listing of allListing) { %>
        <div class="col">
          <a href="/listing/<%= listing._id %>" class="listing-link">
            <div class="card listing-card">
              <img src="<%= listing.image.url %>" class="card-img-top" alt="listing image" />
              <div class="card-img-overlay"></div>
              <div class="card-body">
                <p class="card-text">
                  <b>
                    <%= listing.title %>
                  </b><br />
                  ₹<%= listing.price.toLocaleString("en-IN") %>/night
                    <i class="tax-info"> +18% GST</i>
                </p>
              </div>
            </div>
          </a>
        </div>
        <% } %>
    </div>
  </div>

  <script>
    const taxSwitch = document.getElementById("switchCheckDefault");
    taxSwitch.addEventListener("click", () => {
      const taxInfo = document.getElementsByClassName("tax-info");
      for (let info of taxInfo) {
        info.style.display = (info.style.display === "inline") ? "none" : "inline";
      }
    });
  </script>