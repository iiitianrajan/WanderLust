<% layout("/layouts/boilerplates") %>

<div class="container-xl mt-4">
  <div class="row justify-content-center">
    <div class="col-lg-7 col-md-9 col-sm-11">

      <h2 class="mb-4 text-center">Edit Your Listing</h2>

      <form
        method="POST"
        action="/listing/<%= listing._id %>?_method=PUT"
        novalidate
        class="needs-validation"
        enctype="multipart/form-data"
      >

        <div class="mb-3">
          <label for="title" class="form-label">Title</label>
          <input
            type="text"
            value="<%= listing.title %>"
            name="listing[title]"
            class="form-control"
            id="title"
            required
          />
          <div class="invalid-feedback">Invalid title</div>
        </div>

        <div class="mb-3">
          <label for="description" class="form-label">Description</label>
          <textarea
            name="listing[description]"
            class="form-control"
            id="description"
            rows="5"
            required
          ><%= listing.description %></textarea>
          <div class="invalid-feedback">Invalid description</div>
        </div>

        <div class="mb-3">
          <label class="form-label d-block">Original Listing Image</label>
          <img
            src="<%= originalImageUrl %>"
            alt="listing image"
            class="img-fluid rounded"
            style="max-width: 260px;"
          />
        </div>

        <div class="mb-3">
          <label for="image" class="form-label">Upload New Image</label>
          <input
            type="file"
            class="form-control"
            name="listing[image]"
            id="image"
          />
        </div>

        <div class="row">
          <div class="mb-3 col-md-4">
            <label for="price" class="form-label">Price</label>
            <input
              type="number"
              value="<%= listing.price %>"
              name="listing[price]"
              class="form-control"
              id="price"
              required
            />
            <div class="invalid-feedback">Invalid price</div>
          </div>

          <div class="mb-3 col-md-8">
            <label for="country" class="form-label">Country</label>
            <input
              type="text"
              value="<%= listing.country %>"
              name="listing[country]"
              class="form-control"
              id="country"
              required
            />
            <div class="invalid-feedback">Invalid country</div>
          </div>
        </div>

        <div class="mb-3">
          <label for="location" class="form-label">Location</label>
          <input
            type="text"
            value="<%= listing.location %>"
            name="listing[location]"
            class="form-control"
            id="location"
            required
          />
          <div class="invalid-feedback">Invalid location</div>
        </div>

        <div class="d-grid mt-4">
          <button class="btn btn-dark add-btn">
            Update Listing
          </button>
        </div>

      </form>
    </div>
  </div>
</div>
