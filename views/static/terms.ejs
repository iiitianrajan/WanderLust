<% layout("/layouts/boilerplates") %>

<style>
  .terms-container{
    max-width:900px;
    margin:auto;
    background:#fff;
    padding:35px;
    border-radius:18px;
    box-shadow:0 8px 25px rgba(0,0,0,0.08);
  }

  .terms-title{
    font-weight:700;
    font-size:32px;
  }

  .terms-sub{
    color:#717171;
    font-size:15px;
  }

  .terms-section{
    margin-top:28px;
  }

  .terms-section h5{
    font-weight:600;
    margin-bottom:8px;
  }

  .terms-section p{
    color:#555;
    line-height:1.7;
  }

  .highlight{
    color:#ff385c;
    font-weight:600;
  }
</style>


<div class="container mt-5 mb-5">
  <div class="terms-container">

    <h2 class="terms-title">Terms & Conditions</h2>
    <p class="terms-sub">Last updated: 2026</p>
    <hr>

    <div class="terms-section">
      <h5>1. Introduction</h5>
      <p>
        Welcome to our <span class="highlight">Airbnb Clone</span>. 
        These terms and conditions outline the rules and regulations for using this website. 
        This platform is created for educational and portfolio demonstration purposes only.
      </p>
    </div>

    <div class="terms-section">
      <h5>2. Use of Website</h5>
      <p>
        Users can browse listings, create bookings, add reviews, and explore features 
        for learning and demonstration. This project is not intended for commercial use 
        or real property transactions.
      </p>
    </div>

    <div class="terms-section">
      <h5>3. Account Responsibility</h5>
      <p>
        Users are responsible for maintaining the confidentiality of their login credentials. 
        Any activity performed through the account is considered the responsibility of the user.
      </p>
    </div>

    <div class="terms-section">
      <h5>4. No Real Transactions</h5>
      <p>
        This website does not support real payment processing. All bookings and listings 
        are part of a demo system built for educational purposes only.
      </p>
    </div>

    <div class="terms-section">
      <h5>5. User Content</h5>
      <p>
        Users may post reviews or listing information. Any inappropriate or harmful content 
        may be removed to maintain a safe learning environment.
      </p>
    </div>

    <div class="terms-section">
      <h5>6. Limitation of Liability</h5>
      <p>
        Since this is a demo project, we are not responsible for any real-world damages, 
        data loss, or misunderstandings arising from the use of this website.
      </p>
    </div>

    <div class="terms-section">
      <h5>7. Changes to Terms</h5>
      <p>
        These terms may be updated anytime for improvement of the project or compliance 
        with educational requirements.
      </p>
    </div>

    <div class="terms-section">
      <h5>8. Acceptance of Terms</h5>
      <p>
        By using this website, you acknowledge that this is a demo project and agree 
        to these terms and conditions.
      </p>
    </div>

  </div>
</div>
